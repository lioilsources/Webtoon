<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Your voice (lib/voice): recorded only on the player's request. RECORD_AUDIO implies a microphone;
         required="false" keeps the app on devices without one (TV, some tablets). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <!-- usesCleartextTraffic: the dev backend runs on plain http (WEBTOON_API). -->
    <application
        android:label="Toonfork"
        android:usesCleartextTraffic="true"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- No launcher filter here: the launcher entries are the .Icon_* aliases below (one enabled at a
                 time, switched by the icon picker in Nastavení via MainActivity's "toonfork/app_icon" channel). -->
        </activity>
        <!-- app icons (tools/app_icons.py) -->
        <activity-alias android:name=".Icon_stargirl" android:targetActivity=".MainActivity" android:icon="@mipmap/ic_launcher" android:enabled="true" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".Icon_noirgirl" android:targetActivity=".MainActivity" android:icon="@mipmap/ic_launcher_noirgirl" android:enabled="false" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".Icon_comicgirl" android:targetActivity=".MainActivity" android:icon="@mipmap/ic_launcher_comicgirl" android:enabled="false" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".Icon_noirboy2" android:targetActivity=".MainActivity" android:icon="@mipmap/ic_launcher_noirboy2" android:enabled="false" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".Icon_stargirl2" android:targetActivity=".MainActivity" android:icon="@mipmap/ic_launcher_stargirl2" android:enabled="false" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".Icon_classic" android:targetActivity=".MainActivity" android:icon="@mipmap/ic_launcher_classic" android:enabled="false" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".Icon_panelsstar" android:targetActivity=".MainActivity" android:icon="@mipmap/ic_launcher_panelsstar" android:enabled="false" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".Icon_panelsnoir2" android:targetActivity=".MainActivity" android:icon="@mipmap/ic_launcher_panelsnoir2" android:enabled="false" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".Icon_panelsnoir" android:targetActivity=".MainActivity" android:icon="@mipmap/ic_launcher_panelsnoir" android:enabled="false" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <!-- /app icons -->
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebtoonStoryKids",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "synopsis",
    "ending",
    "characters",
    "locations",
    "panels"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "synopsis": {
      "type": "string",
      "minLength": 10,
      "maxLength": 240
    },
    "ending": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120,
      "description": "Ending as a constraint, exactly as the source states it, e.g. 'Šťastný konec: mech se stane přítelem.' or 'Pokračování příště.'"
    },
    "characters": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "kind",
              "gender",
              "base",
              "outfits",
              "photo"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "name": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "child"
                ]
              },
              "gender": {
                "type": "string",
                "enum": [
                  "f",
                  "m"
                ]
              },
              "base": {
                "type": "string",
                "pattern": "^(female|male) child, .+"
              },
              "outfits": {
                "type": "object",
                "required": [
                  "default"
                ],
                "minProperties": 1,
                "maxProperties": 4,
                "additionalProperties": {
                  "type": "string",
                  "minLength": 8
                },
                "description": "Clothes as Danbooru tags; 'default' required."
              },
              "photo": {
                "type": "string",
                "minLength": 20,
                "maxLength": 200,
                "description": "One English sentence: 'a … girl/boy aged N' with 6 <= N <= 13, hair, build, face feature. No clothing."
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "kind",
              "gender",
              "base",
              "outfits",
              "photo"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "name": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "adult"
                ]
              },
              "gender": {
                "type": "string",
                "enum": [
                  "f",
                  "m"
                ]
              },
              "base": {
                "type": "string",
                "pattern": "^adult, mature (fe)?male, .+"
              },
              "outfits": {
                "type": "object",
                "required": [
                  "default"
                ],
                "minProperties": 1,
                "maxProperties": 4,
                "additionalProperties": {
                  "type": "string",
                  "minLength": 8
                },
                "description": "Clothes as Danbooru tags; 'default' required."
              },
              "photo": {
                "type": "string",
                "minLength": 20,
                "maxLength": 200,
                "description": "One English sentence: nationality, 'aged N' with N >= 23, hair, build, face feature. No clothing."
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "kind",
              "gender",
              "base",
              "outfits",
              "photo"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "name": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "creature",
                  "robot",
                  "spirit"
                ]
              },
              "gender": {
                "type": "string",
                "enum": [
                  "f",
                  "m",
                  "n"
                ]
              },
              "base": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9 ,'()-]+$"
              },
              "outfits": {
                "type": "object",
                "required": [
                  "default"
                ],
                "minProperties": 1,
                "maxProperties": 4,
                "additionalProperties": {
                  "type": "string",
                  "minLength": 3
                },
                "description": "Markings, accessories or gear as Danbooru tags ('red collar', 'glowing blue visor'); 'default' required, may be short."
              },
              "photo": {
                "type": "string",
                "minLength": 20,
                "maxLength": 200,
                "description": "One English sentence describing the being (species or build, colour, size, one striking feature). No human words."
              }
            }
          }
        ]
      }
    },
    "locations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "tag_prompt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^l_[a-z0-9_]+$"
          },
          "name": {
            "type": "string"
          },
          "tag_prompt": {
            "type": "string",
            "pattern": "^(indoors|outdoors), .+"
          }
        }
      }
    },
    "panels": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shot",
          "location_id",
          "characters",
          "visual_tags",
          "bubbles",
          "sfx",
          "gap_after",
          "animate",
          "motion"
        ],
        "properties": {
          "shot": {
            "type": "string",
            "enum": [
              "establishing",
              "wide",
              "medium",
              "close-up",
              "over-shoulder"
            ]
          },
          "location_id": {
            "type": "string"
          },
          "characters": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "outfit": {
                  "type": "string"
                }
              }
            },
            "description": "Up to 3 characters, of which at most 2 are humans (kind child or adult)."
          },
          "visual_tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "bubbles": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "speaker_id",
                "text",
                "kind"
              ],
              "properties": {
                "speaker_id": {
                  "type": "string"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 140
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "speech",
                    "thought",
                    "shout",
                    "narration"
                  ]
                }
              }
            }
          },
          "sfx": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12
            }
          },
          "gap_after": {
            "type": "string",
            "enum": [
              "small",
              "medium",
              "large"
            ]
          },
          "animate": {
            "type": "boolean",
            "description": "Render this panel as a 1–3 s seamless loop (at most 2 per story)."
          },
          "motion": {
            "type": "string",
            "maxLength": 120,
            "description": "Wan I2V motion prompt in English: subject motion + ambient + 'static camera'; a panel with 2+ characters: 'ambient only, characters still, <ambient>, static camera'. Empty when animate is false."
          }
        }
      }
    }
  }
}
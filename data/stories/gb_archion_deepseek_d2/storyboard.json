        "from front",
        "serious",
        "looking at a laptop screen"
      ],
      "bubbles": [
        {
          "speaker_id": "ol1n_podzim",
          "text": "Já jsem ti řekl, ať to nezahazuješ, protože to byl tvůj sen. Ne protože to byl dobrý nápad.",
          "kind": "speech"
        }
      ],
      "sfx": [],
      "gap_after": "small"

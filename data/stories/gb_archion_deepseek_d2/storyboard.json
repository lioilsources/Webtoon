        "looking down",
        "quiet"
      ],
      "bubbles": [
        {
          "speaker_id": "kosmo",
          "text": "Já tě neurážím. Já tě… já tě nepoznávám. Dvacet let. Ty jsi byl ten, kdo mi řekl, ať to nezahazuju. A pak jsi mi řekl, ať to zahodím.",
          "kind": "speech"
        },
        {
          "speaker_id": "kosmo",
          "text": "A pak jsi to udělal sám.",
          "kind": "speech"
        }
      ],
      "sfx": [],
      "gap_after": "small"
    },
    {
      "shot": "close-up",
      "location_id": "l_dzahrada",

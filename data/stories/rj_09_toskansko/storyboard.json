        "skeptical",
        "raised eyebrow"
      ],
      "bubbles": [
        {
          "speaker_id": "hana",
          "text": "A průvodce, na kterého se nezapomíná? Slyšela jsem. Každá skupina má jednu, co vám na týden uvěří.",
          "kind": "speech"
        }
      ],
      "sfx": [],
      "gap_after": "medium"
    },
    {
      "shot": "close-up",
      "location_id": "l_vineyard",
      "characters": [
        {

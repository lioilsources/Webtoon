        "cicadas"
      ],
      "bubbles": [
        {
          "speaker_id": "hana",
          "text": "Mám jeden slib: zamiluju se jen do sebe. Žádné „ciao bella“, žádné loučení na letišti.",
          "kind": "speech"
        }
      ],
      "sfx": [],
      "gap_after": "medium"

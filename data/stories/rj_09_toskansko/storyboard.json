          "outfit": "lunch"
        }
      ],
      "visual_tags": [
        "serious",
        "no smile"
      ],
      "bubbles": [
        {
          "speaker_id": "marco",
          "text": "Poznám, kdy se žena směje doopravdy. Vy jste se smála třikrát. Naposledy teď, když jste řekla, že se nezamilujete.",
          "kind": "speech"
        }
      ],
      "sfx": [],

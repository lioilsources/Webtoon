        }
      ],
      "visual_tags": [
        "grin",
        "playful"
      ],
      "bubbles": [
        {
          "speaker_id": "marco",
          "text": "A každá skupina má jednu, co se mi snaží nesmát. Ta je vždycky nejzajímavější.",
          "kind": "speech"
        }
      ],
      "sfx": [],
      "gap_after": "large"
    },

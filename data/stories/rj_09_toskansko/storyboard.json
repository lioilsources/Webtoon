      "bubbles": [
        {
          "speaker_id": "marco",
          "text": "Signora Hana! Dvacet kilometrů, tři kopce a oběd, na který se nezapomíná.",
          "kind": "speech"
        }
      ],
      "sfx": [],
      "gap_after": "medium"

      "bubbles": [
        {
          "speaker_id": "max",
          "text": "Hej, pane Krabe! Tohle sklo není na hranění! Čas na chobotničkový tanec!",
          "kind": "shout",
          "i18n": {
            "de": "Hey, Herr Krabbe! Dieses Glas ist kein Spielzeug! Zeit für den Tintenfisch-Tanz!",
            "en": "Hey, Mr. Crab! That glass isn't for playing with! Time for the Octopus Dance!",
            "fr": "Hé, Monsieur Crabe ! Ce verre n'est pas un jouet ! Place à la danse des tentacules !",
            "it": "Ehi, signor Granchio! Questo vetro non è un giocattolo! È ora del ballo dei tentacoli!",
            "ja": "おい、カニさん！そのガラスは遊んでるものじゃないよ！イカダンスの時間だ！",
            "ko": "이봐, 게 아저씨! 그 유리는 장난감 아니야! 문어발 춤 시간!",
            "pl": "Hej, Panie Krabie! To szkło nie jest do zabawy! Czas na taniec ośmiorniczy!",
            "pt-BR": "Ei, Sr. Caranguejo! Isso não é brinquedo! Hora da dança do polvo!",
            "ru": "Эй, мистер Краб! Это стекло не для игр! Время танца осьминожек!",
            "uk": "Ей, пане Крабе! Це скло не для ігор! Час на танець восьминога!",
            "vi": "Này, ông Cua! Cái kính này không phải để chơi đùa! Giờ là lúc nhảy múa như bạch tuộc!"
          }
        }
      ],
      "sfx": [

      "visual_tags": [
        "upper body",
        "sitting at a desk",
        "from front",
        "cruel expression",
        "typing hard"
      ],
      "bubbles": [
        {
          "speaker_id": "kosmo",
          "text": "Ty umíš jen jedno: vzít člověku práci, rozebrat ji a říct mu, ať ji smaže. Není divu, že tě nikde dlouho nedrží.",
          "kind": "speech"
        }
      ],
      "sfx": [],
      "gap_after": "small"
    },

        "from front",
        "typing",
        "calm expression"
      ],
      "bubbles": [
        {
          "speaker_id": "ol1n_podzim",
          "text": "Já sdílím rád. Ale pochopil jsem, že ty to máš nastavené jinak.",
          "kind": "speech"
        }
      ],
      "sfx": [],
      "gap_after": "small"

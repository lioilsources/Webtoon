      "bubbles": [
        {
          "speaker_id": "kosmo",
          "text": "Ať je jasno: o vývoji se s tebou už bavit nechci. Spolupráce nevyšla. Něco mě naštvalo a něco fakt bolelo.",
          "kind": "speech"
        }
      ],

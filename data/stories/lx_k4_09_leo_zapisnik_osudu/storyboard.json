      "bubbles": [
        {
          "speaker_id": "king",
          "text": "Jsi jen malé dítě, Leo! Neznáš mé pravé jméno! Nemůžeš mě porazit!",
          "kind": "speech",
          "i18n": {
            "de": "Du bist nur ein kleines Kind, Leo! Du kennst meinen wahren Namen nicht! Du kannst mich nicht besiegen!",
            "en": "You're just a kid, Leo! You don't know my true name! You can't defeat me!",
            "fr": "Tu n'es qu'un petit enfant, Leo ! Tu ne connais pas mon vrai nom ! Tu ne peux pas me vaincre !",
            "it": "Sei solo un bambino, Leo! Non conosci il mio vero nome! Non puoi sconfiggermi!",
            "ja": "お前はただの小さな子供だ、レオ！俺の本名など知らねえ！倒せるわけねえだろうが！",
            "ko": "너는 그냥 어린애일 뿐이야, 레오! 내 진명을 모른다고! 나를 이길 수 없어!",
            "pl": "Jesteś tylko małym dzieckiem, Leo! Nie znasz mojego prawdziwego imienia! Nie możesz mnie pokonać!",
            "pt-BR": "Você só é uma criança, Leo! Você não conhece meu verdadeiro nome! Não pode me derrotar!",
            "ru": "Ты всего лишь ребёнок, Лео! Ты не знаешь моего истинного имени! Ты не сможешь меня победить!",
            "uk": "Ти лише маленька дитина, Лео! Ти не знаєш мого справжнього імені! Ти не зможеш мене перемогти!",
            "vi": "Cậu chỉ là một đứa trẻ con, Leo! Cậu không biết tên thật của ta! Không thể đánh bại ta được đâu!"
          }
        }
      ],
      "sfx": [],
      "gap_after": "medium"
    },
    {
      "shot": "medium",
      "location_id": "l_ruins",
      "characters": [
        {
          "id": "leo"
        }
      ],
      "visual_tags": [
        "adjusting glasses",
        "smirk",
        "cool smile",
        "holding pen",
        "confident",
        "looking up"
      ],
      "bubbles": [
        {
          "speaker_id": "leo",
          "text": "Ale já tvoje jméno znám. Přečetl jsem si ho v prastarých svitcích knihovny!",
          "kind": "speech",
          "i18n": {
            "de": "Doch ich kenne deinen Namen. Ich habe ihn in den uralten Schriftrollen der Bibliothek gelesen!",
            "en": "But I do know your name. I read it in the ancient scrolls of the library!",
            "fr": "Si, je le connais. Je l'ai lu dans les vieux parchemins de la bibliothèque !",
            "it": "Invece, il tuo nome lo conosco. L'ho letto nei rotoli antichi della biblioteca!",
            "ja": "でも俺はお前の名前を知っている。古書庫の巻物で読んだんだ！",
            "ko": "하지만 난 네 이름을 알고 있어. 고대의 두루마리에서 읽었거든!",
            "pl": "Ale ja znam twoje imię. Przeczytałem je w pradawnych zwojach z biblioteki!",
            "pt-BR": "Mas eu conheço seu nome. Li nos pergaminhos antigos da biblioteca!",
            "ru": "Но я знаю твоё имя. Я прочитал его в древних свитках библиотеки!",
            "uk": "Але я знаю твоє ім'я. Я прочитав його в давніх сувоях бібліотеки!",
            "vi": "Nhưng ta biết tên cậu mà. Ta đã đọc nó trong những cuộn giấy cổ xưa của thư viện!"
          }
        }
      ],

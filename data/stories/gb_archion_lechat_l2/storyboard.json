      "bubbles": [
        {
          "speaker_id": "ol1n_leto",
          "text": "O penězích na release Nebulonu, který se nikdy neuskutečnil, snad raději ani mluvit nebudu.",
          "kind": "speech"
        },
        {
          "speaker_id": "ol1n_leto",
          "text": "Beru to tak, že mi za to dáváš svolení releasnout svůj vlastní projekt.",
          "kind": "speech"
        }

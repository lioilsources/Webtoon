      "bubbles": [
        {
          "speaker_id": "viktor",
          "text": "Nechci slyšet „můžeme si psát“. Chci slyšet pravdu.",
          "kind": "speech"
        },
        {
          "speaker_id": "greta",
          "text": "Do toho plánu se právě vešel jeden doktor z Karlových Varů. A nevím, co s tím.",

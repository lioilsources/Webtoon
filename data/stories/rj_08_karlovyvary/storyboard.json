    {
      "shot": "close-up",
      "location_id": "l_spa",
      "characters": [
        {
          "id": "viktor"
        }
      ],
      "visual_tags": [
        "looking down",
        "glasses fogged",
        "sad"
      ],
      "bubbles": [
        {
          "speaker_id": "viktor",
          "text": "Manželství, které skončilo. Syn, který píše jednou za tři měsíce. A kdo jsem, když nejsem doktor?",
          "kind": "speech"
        }
      ],
      "sfx": [],
      "gap_after": "small"
    },
    {
      "shot": "close-up",
      "location_id": "l_spa",
      "characters": [
        {
          "id": "greta",
          "outfit": "spa"
        }
      ],
      "visual_tags": [
        "gentle",
        "attentive",
        "steam"
      ],
      "bubbles": [
        {
          "speaker_id": "greta",
          "text": "Tělo nelže. Tak mi řekněte: co cítíte?",
          "kind": "speech"
        },
        {
          "speaker_id": "viktor",
          "text": "Že poprvé za deset let nechci být večer sám.",
          "kind": "speech"
        }
      ],
      "sfx": [],
      "gap_after": "large"
    },
    {

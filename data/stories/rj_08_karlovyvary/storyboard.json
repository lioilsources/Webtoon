        "woman in robe sitting next to him",
        "steam"
      ],
      "bubbles": [
        {
          "speaker_id": "viktor",
          "text": "Nebojím se vody. Bojím se klidu. V klidu se ozvou věci, které odkládám.",
          "kind": "speech"
        }
      ],
      "sfx": [],
      "gap_after": "medium"

      "bubbles": [
        {
          "speaker_id": "greta",
          "text": "Vy jste ten lékař, co kouká na fontánu, jako by ji chtěl operovat.",
          "kind": "speech"
        },
        {
          "speaker_id": "viktor",
          "text": "A vy ta fyzioterapeutka, co běhá kolonádou, jako by ji honilo vlastní volno.",
          "kind": "speech"

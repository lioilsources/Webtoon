      "bubbles": [
        {
          "speaker_id": "noah",
          "text": "Nevím, co ten tanec znamenal. Ale cítil jsem ho tady.",
          "kind": "speech"
        },
        {
          "speaker_id": "ayu",
          "text": "Jste první host, který neříká „krásné“. Všichni říkají „krásné“.",
          "kind": "speech"

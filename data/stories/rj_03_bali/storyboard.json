        "embarrassed"
      ],
      "bubbles": [
        {
          "speaker_id": "noah",
          "text": "Jsem Australan. „Krásné“ nám trvá dvě hodiny. „Cítil jsem“ jde rychle.",
          "kind": "speech"
        }
      ],
      "sfx": [],
      "gap_after": "small"

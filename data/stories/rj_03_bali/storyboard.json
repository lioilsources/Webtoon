      "bubbles": [
        {
          "speaker_id": "ayu",
          "text": "Zítra v šest je odliv. Půjčím vám prkno.",
          "kind": "speech"
        },
        {
          "speaker_id": "noah",
          "text": "A co tanec pro vás?",
          "kind": "speech"
        }

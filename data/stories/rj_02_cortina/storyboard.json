      "bubbles": [
        {
          "speaker_id": "matteo",
          "text": "Chtěl jsem zavolat. Ale já nejsem člověk pro telefonáty. Jsem člověk pro hory.",
          "kind": "speech"
        },
        {
          "speaker_id": "klara",
          "text": "A co jsi za člověka, Matteo, když nejsi na hoře?",

      ],
      "bubbles": [
        {
          "speaker_id": "matteo",
          "text": "Signora. Jste tu poprvé? Ten postoj na lyžích je na vás vidět.",
          "kind": "speech"
        },
        {
          "speaker_id": "klara",
          "text": "Druhý rok. Lyžuju kvůli instruktorovi, který mě loni naučil první oblouk a pak se neozval.",
          "kind": "speech"
        }
      ],
      "sfx": [],

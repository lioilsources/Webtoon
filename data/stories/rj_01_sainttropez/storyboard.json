      "bubbles": [
        {
          "speaker_id": "valentina",
          "text": "Pět let jsem dělala PR pro cizí sny. Zapomněla jsem, jaké jsou moje.",
          "kind": "speech"
        }
      ],
      "sfx": [],
      "gap_after": "medium"

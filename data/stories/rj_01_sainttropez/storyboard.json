        "man leaning over railing",
        "woman on pier",
        "looking at each other"
      ],
      "bubbles": [
        {
          "speaker_id": "luca",
          "text": "Já. Ale jen abych vás pozval na večerní plavbu. Žádný přístav, žádní lidé. Jen vítr a víno.",
          "kind": "speech"
        },
        {
          "speaker_id": "valentina",
          "text": "Pozvání na útěk je nejlepší lichotka. V osm?",
          "kind": "speech"
        }
      ],
      "sfx": [],
      "gap_after": "large"
    },

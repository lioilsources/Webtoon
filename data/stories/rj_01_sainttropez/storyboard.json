      "visual_tags": [
        "amused smile",
        "raised eyebrow",
        "looking up"
      ],
      "bubbles": [
        {
          "speaker_id": "valentina",
          "text": "A vy se díváte na mě. Tak kdo z nás dvou se tu nepředvádí?",
          "kind": "speech"
        }
      ],
      "sfx": [],
      "gap_after": "small"

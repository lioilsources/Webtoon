      "bubbles": [
        {
          "speaker_id": "luca",
          "text": "Madame! Jste jediná v přístavu, kdo se dívá na moře. Ostatní koukají na jachty.",
          "kind": "speech"
        }
      ],
      "sfx": [],
      "gap_after": "medium"

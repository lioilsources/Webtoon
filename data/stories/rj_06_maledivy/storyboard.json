        "floating at surface",
        "masks pushed up",
        "talking",
        "sunlight"
      ],
      "bubbles": [
        {
          "speaker_id": "dominik",
          "text": "Dvacet let jsem stavěl firmy. Nikdy jsem neviděl nic tak klidného.",
          "kind": "speech"
        },
        {
          "speaker_id": "naia",
          "text": "Pod vodou se nedá lhát. Všechno je vidět. I to, před čím člověk utekl.",
          "kind": "speech"
        }
      ],
      "sfx": [],
      "gap_after": "medium"
    },
    {
      "shot": "close-up",
      "location_id": "l_reef",
      "characters": [
        {
          "id": "dominik",
          "outfit": "dive"
        }

        "woman greeting",
        "mask on forehead",
        "man taking off sunglasses"
      ],
      "bubbles": [
        {
          "speaker_id": "naia",
          "text": "Vítejte. Jsem Naia. Potápění je jen plavání s důvěrou. Tu vám tady dáme.",
          "kind": "speech"
        },
        {
          "speaker_id": "naia",
          "text": "Ale máte na sobě oblek. Tak spíš za dva dny.",
          "kind": "speech"
        }
      ],
      "sfx": [],
      "gap_after": "medium"
    },
    {
      "shot": "close-up",
      "location_id": "l_jetty",
      "characters": [
        {
          "id": "naia"
        }
      ],
      "visual_tags": [
        "calm",
        "serious",
        "looking at viewer"
      ],
      "bubbles": [
        {
          "speaker_id": "naia",
          "text": "Útěk před vlastním životem se na ostrově neschová. Voda vám ho ukáže.",
          "kind": "speech"
        }
      ],
      "sfx": [],
      "gap_after": "large"
    },
    {
      "shot": "medium",
      "location_id": "l_reef",
      "characters": [
        {
          "id": "dominik",

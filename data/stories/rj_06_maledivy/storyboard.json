          "text": "Investor, který se učí potápět. A když se to nenaučí?",
          "kind": "speech"
        },
        {
          "speaker_id": "dominik",
          "text": "Tak zůstane s průvodkyní, která ho drží nad vodou.",
          "kind": "speech"
        }

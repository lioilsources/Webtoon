      "visual_tags": [
        "sad",
        "wet hair",
        "looking down"
      ],
      "bubbles": [
        {
          "speaker_id": "dominik",
          "text": "Žena odešla před rokem. Utekl jsem do práce. Práce neodejde.",
          "kind": "speech"
        },
        {
          "speaker_id": "naia",
          "text": "Ale ani neumí zůstat.",
          "kind": "speech"
        }
      ],
      "sfx": [],
      "gap_after": "large"
    },
    {

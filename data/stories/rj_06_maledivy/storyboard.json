      "bubbles": [
        {
          "speaker_id": "naia",
          "text": "Za tři dny odjíždíte.",
          "kind": "speech"
        },
        {
          "speaker_id": "dominik",
          "text": "Odjíždím. Ale ne z ostrova. Z života, který jsem měl.",

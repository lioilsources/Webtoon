      "bubbles": [
        {
          "speaker_id": "robot",
          "text": "Vážená hosto. Parmazán byl nastrouhán ručně.",
          "kind": "speech",
          "i18n": {
            "de": "Verehrte Gästin. Der Parmesan wurde von Hand gerieben.",
            "en": "Dear guestess. The parmesan has been grated by hand.",
            "fr": "Chère cliente invitée. Le parmesan a été râpé à la main.",
            "it": "Gentile ospita. Il parmigiano è stato grattugiato a mano.",
            "ja": "お客様奥様。パルメザンは手作業で削りました。",
            "ko": "손님 여사님. 파르메산은 손으로 갈았습니다.",
            "pl": "Szanowna gościni. Parmezan został starty ręcznie.",
            "pt-BR": "Prezada convidada-cliente. O parmesão foi ralado à mão.",

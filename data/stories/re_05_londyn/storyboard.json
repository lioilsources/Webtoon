   "bubbles": [
    {
     "speaker_id": "daniel",
     "text": "Váš deštník právě zemřel. Pojďte dovnitř, než skončíte jako on.",
     "kind": "speech"
    }
   ],
   "sfx": [],
   "gap_after": "medium"

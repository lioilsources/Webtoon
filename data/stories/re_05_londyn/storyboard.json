    "blush"
   ],
   "bubbles": [
    {
     "speaker_id": "zofia",
     "text": "Já zvládnu cokoliv. Jen ne deštníky. A ne muže, kteří vaří, protože pak nechci odejít.",
     "kind": "speech"
    }
   ],
   "sfx": [],

    {
      "shot": "close-up",
      "location_id": "l_xzahrada_4",
      "characters": [
        {
          "id": "ol1n_kabat"
        }
      ],
      "visual_tags": [
        "upper body",
        "sitting at a garden table",
        "from front",
        "quiet",
        "snowflakes on his beard",
        "looking down"
      ],
      "bubbles": [
        {
          "speaker_id": "ol1n_kabat",
          "text": "Kámo… chybět mi nebudeš.",
          "kind": "speech"
        }
      ],
      "sfx": [],
      "gap_after": "small"
    },
    {
      "shot": "close-up",
      "location_id": "l_xzahrada_4",
      "characters": [
        {
          "id": "ol1n_kabat"
        }
      ],
      "visual_tags": [
        "upper body",
        "sitting at a garden table",
        "from front",
        "pained expression",
        "looking at a laptop screen"
      ],
      "bubbles": [
        {
          "speaker_id": "ol1n_kabat",
          "text": "Když jsem byl ve svém životě nejvíc v hajzlu a hledal u tebe útočiště, vyhodils mě po dvou dnech jak největšího fakana. To se nezapomíná.",
          "kind": "speech"
        }
      ],
      "sfx": [],
      "gap_after": "small"
    },
    {
      "shot": "medium",
      "location_id": "l_xzahrada_4",
      "characters": [
        {
          "id": "ol1n_kabat"
        }
      ],
      "visual_tags": [
        "upper body",
        "sitting at a garden table",
        "from front",
        "tired expression",
        "looking down"
      ],
      "bubbles": [
        {
          "speaker_id": "ol1n_kabat",
          "text": "Nikdys mě nenechal udělat ti nabídku na padesát na padesát, kterou jsem vždycky považoval za samozřejmost. Ta nabídka pořád platí. I teď.",
          "kind": "speech"
        }
      ],
      "sfx": [],
      "gap_after": "small"
    },
    {
      "shot": "close-up",
      "location_id": "l_xzahrada_4",
      "characters": [
        {
          "id": "ol1n_kabat"
        }
      ],
      "visual_tags": [
        "upper body",
        "sitting at a garden table",
        "from front",
        "sad",
        "calm"
      ],
      "bubbles": [
        {
          "speaker_id": "ol1n_kabat",
          "text": "Ale ty sis vybral cestu výhrůžek a blokování.",
          "kind": "speech"
        }
      ],
      "sfx": [],
      "gap_after": "small"
    },
    {
      "shot": "close-up",
      "location_id": "l_xzahrada_4",
      "characters": [
        {
          "id": "ol1n_kabat"
        }
      ],
      "visual_tags": [
        "upper body",
        "sitting at a garden table",
        "from front",
        "calm",
        "final",
        "looking at a laptop screen"
      ],
      "bubbles": [
        {
          "speaker_id": "ol1n_kabat",
          "text": "R.I.P.",
          "kind": "speech"
        }

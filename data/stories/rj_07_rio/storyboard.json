      "bubbles": [
        {
          "speaker_id": "beatriz",
          "text": "Za tři dny São Paulo. Pak Milán. Pak New York. Móda je kolotoč a já se bojím vystoupit.",
          "kind": "speech"
        },
        {
          "speaker_id": "thiago",
          "text": "A co byste dělala, kdybyste vystoupila?",

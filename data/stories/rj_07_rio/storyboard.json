      ],
      "bubbles": [
        {
          "speaker_id": "beatriz",
          "text": "Poprvé jsem se necítila jako modelka, ale jako žena. To mě děsí víc než celý Milán.",
          "kind": "speech"
        },
        {
          "speaker_id": "beatriz",
          "text": "Nemůžu. Je mi to líto.",

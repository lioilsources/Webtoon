# Copy to worker.env (gitignored) next to docker-compose.yml on Spark.
VOICE_API_URL=https://webtoon-api.ol1n.com
# The same value as VOICE_WORKER_TOKEN in deploy/.env on JODA; copy it without printing it (docs/voice-backend.md).
VOICE_WORKER_TOKEN=<from-joda>
VOICE_WORKER_NAME=spark-1
AUDIO_URL=http://localhost:8093
# AUDIO_API_KEY=                # only when the audio service has AUDIO_API_KEY set
SPARK_BROKER=http://localhost:8100
# SPARK_BROKER_TOKEN=           # only when the broker has BROKER_TOKEN set
VOICE_BROKER_PRIORITY=20

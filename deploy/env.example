# deploy/.env on JODA (gitignored, chmod 600). deploy.sh creates it and adds missing keys; never commit
# real values and never print them. Every value here is a placeholder.
POSTGRES_PASSWORD=<generated by deploy.sh>
STUDIO_TOKEN=<generated by deploy.sh>
# DB_BIND=<JODA LAN address>       # optional, Postgres for the Mac

# Player voice (docs/voice-backend.md)
VOICE_DATA_KEY=<generated by deploy.sh: 64 hex chars; losing it makes stored samples unreadable>
VOICE_WORKER_TOKEN=<generated by deploy.sh; the Spark worker uses the same value>
# VOICE_APPLE_BUNDLE_ID=com.ol1n.webtoon      # default in docker-compose.yml
# VOICE_GOOGLE_PACKAGE=com.ol1n.webtoon       # Play also needs ../secrets/play-service-account.json
# VOICE_RECEIPT_MODE=store                    # "test" is refused on webtoon-api.ol1n.com anyway
# VOICE_RETENTION_DAYS=180
# VOICE_DAILY_LINES=300
